{
  "manifest_version": 3,
  "name": "个人系统",
  "version": "7.2.1",
  "description": "个人系统：时间记录、阶段计划、灵感与生活随记、Notion 同步和自动复盘。",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "storage",
    "tabs",
    "idle",
    "notifications"
  ],
  "action": {
    "default_title": "打开今日工作台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "<all_urls>",
    "https://chatgpt.com/*"
  ]
}
